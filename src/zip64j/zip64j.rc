/*
 * zip64j.rc - Version info resource for zip64j.dll
 */

#pragma code_page(65001)   /* source is UTF-8; required for Japanese strings */

#include <winver.h>

/* Fields 1-3 mirror the project version vX.Y.Z. GetVersion returns
 * MAJOR*100 + MINOR, which archiver hosts print as "%d.%02d" - so 0,20,0
 * shows as "0.20". MINOR is a two-digit field: keep it under 100. */
#define ZIP64J_VERSION_MAJOR    0
#define ZIP64J_VERSION_MINOR    20
#define ZIP64J_VERSION_PATCH    0
#define ZIP64J_VERSION_BUILD    0

#define STRINGIFY_(x) #x
#define STRINGIFY(x)  STRINGIFY_(x)
#define ZIP64J_VERSION_STR \
    STRINGIFY(ZIP64J_VERSION_MAJOR) "." \
    STRINGIFY(ZIP64J_VERSION_MINOR) "." \
    STRINGIFY(ZIP64J_VERSION_PATCH) "." \
    STRINGIFY(ZIP64J_VERSION_BUILD)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    ZIP64J_VERSION_MAJOR,ZIP64J_VERSION_MINOR,ZIP64J_VERSION_PATCH,ZIP64J_VERSION_BUILD
 PRODUCTVERSION ZIP64J_VERSION_MAJOR,ZIP64J_VERSION_MINOR,ZIP64J_VERSION_PATCH,ZIP64J_VERSION_BUILD
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        /* 0x0411 = Japanese, 0x04B0 = Unicode */
        BLOCK "041104B0"
        BEGIN
            VALUE "CompanyName",      "zip64j project"
            VALUE "FileDescription",  "zip64j - 統合アーカイバAPI仕様 ZIP DLL (64bit)"
            VALUE "FileVersion",      ZIP64J_VERSION_STR
            VALUE "InternalName",     "zip64j"
            VALUE "LegalCopyright",   "Copyright (c) mtkhs."
            VALUE "OriginalFilename", "zip64j.dll"
            VALUE "ProductName",      "zip64j.dll"
            VALUE "ProductVersion",   ZIP64J_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0411, 0x04B0
    END
END
